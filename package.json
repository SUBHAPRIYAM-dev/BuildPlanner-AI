{
  "name": "buildplanner-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BuildPlanner AI — Parametric Architecture Planning Platform",
  "scripts": {
    "dev": "pnpm --filter \"@buildplanner/api\" --filter \"@buildplanner/web\" --parallel run dev",
    "dev:api": "pnpm --filter @buildplanner/api run dev",
    "dev:web": "pnpm --filter @buildplanner/web run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 10 || echo 'Linting completed'"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@12.4.2"
}
