# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (Leave blank or unset in development to automatically use zero-config embedded in-memory MongoDB)
MONGODB_URI=

# Authentication Secrets
JWT_SECRET=buildplanner_dev_jwt_secret_key_super_secure_12345
JWT_REFRESH_SECRET=buildplanner_dev_refresh_secret_key_super_secure_67890
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Providers
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage Provider
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# Frontend URL
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
